  "narrative": {
    "northStar":"Taller personal",
    "overview":"Ónix es un espacio de escritura y pensamiento en web que sigue patrones reconocibles de Obsidian. Su voz es discreta y directa; los controles están donde se esperan y no compiten con las notas. El archivo Markdown sigue siendo la fuente de verdad.",
    "keyCharacteristics":["Dark-first grafito con variante clara.","Riel, árbol, tabs, editor/preview y status bar.","Geist para UI y Geist Mono para edición/código.","Violeta para acción, foco, selección y enlaces."],
    "rules":[
      {"name":"The Violet Has a Job Rule","body":"El violeta significa acción, foco o navegación; no se dispersa como adorno.","section":"colors"},
      {"name":"The Workspace First Rule","body":"Al entrar, el usuario ve su workspace y notas; ajustes y administración no compiten con la escritura.","section":"layout"}
    ],
    "dos":["Do conservar el orden Obsidian: archivos → nota → editor/preview.","Do mostrar el estado de guardado y distinguir solo lectura.","Do preservar Markdown, frontmatter y wikilinks al guardar."],
    "donts":["Don't convertir el shell de escritura en un dashboard genérico.","Don't separar paneles con sombras cuando bastan superficies tonales.","Don't comunicar estados solo mediante color."]
  }
